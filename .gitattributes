# Normalize line endings for text files.
* text=auto eol=lf

# Godot Asset Library export: ship only the addon + top-level docs.
# Patterns are anchored to the repo root (leading /) so identically-named
# directories inside addons/ are NOT excluded.
/build*/ export-ignore
/godot-cpp/ export-ignore
/quickjs/ export-ignore
/src/ export-ignore
/tools/ export-ignore
/godot-cm/ export-ignore
/openspec/ export-ignore
/docs/ export-ignore
/api/ export-ignore
/.github/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitmodules export-ignore
/CMakeLists.txt export-ignore
/toolchains/ export-ignore
/icon.svg export-ignore
/icon.png export-ignore
