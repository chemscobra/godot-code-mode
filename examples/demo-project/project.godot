; Engine configuration file.
; Demo project for manually testing the godot-cm addon alongside third-party
; plugins (Terrain3D, PhantomCamera). Regenerated editor state lives in
; .godot/ which is intentionally not tracked.

config_version=5

[application]

config/name="Godot CM Demo"
run/main_scene="res://demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_cm/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
